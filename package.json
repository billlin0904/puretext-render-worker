{
  "name": "puretext-render-worker",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke:canvas": "npm run build && node scripts/smoke-canvas.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.7",
    "fontkit": "^2.0.4",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
